{
  "name": "claude-model-triage",
  "version": "2.0.0",
  "description": "Configurable task difficulty triage for Anthropic Claude models and effort levels",
  "type": "module",
  "main": "./dist/model-policy.js",
  "types": "./dist/model-policy.d.ts",
  "exports": {
    ".": {
      "types": "./dist/model-policy.d.ts",
      "import": "./dist/model-policy.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaac-genlimitless/claude-model-triage.git"
  },
  "keywords": [
    "anthropic",
    "claude",
    "model-selection",
    "effort",
    "triage",
    "llm"
  ],
  "engines": {
    "node": ">=22.18"
  }
}
